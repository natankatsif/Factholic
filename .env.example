# Единая конфигурация проекта. Скопируй: cp .env.example .env  (.env в git не попадает)
# Читается в одном месте: backend/src/config.ts (бэкенд) и extension/build.mjs (расширение, при сборке).
# Переменные из командной строки имеют приоритет над .env.

# ======================= БЭКЕНД: сервер =======================
PORT=8787
# pipeline — гонять этапы 01→06 (каждый в mock или real, см. ниже)
# replay   — не запускать пайплайн, проигрывать MOCK_EVENTS из @news/contracts (фронту для разработки UI)
SERVER_MODE=pipeline

# ======================= БЭКЕНД: mock / real по этапам =======================
# mock — этап возвращает данные из своего mock.ts, внешние API не вызываются, ключи не нужны
# real — этап вызывает настоящие API (real.ts), нужны ключи провайдеров ниже
STAGES_DEFAULT=mock
# Переопредели свой этап, не трогая чужие:
# backend-1
# STAGE_INGEST=real
# STAGE_TRANSCRIPTION=real
# STAGE_CLAIM_EXTRACTION=real
# STAGE_SOURCE_SEARCH=real
# backend-2
# STAGE_PROVENANCE=real
# STAGE_MUTATIONS=real
# STAGE_STANCES=real
# (07-root-date и 09-report — чистые функции без внешних API, не переключаются)

# ======================= БЭКЕНД: лимиты =======================
# Сколько утверждений проверять — самые важные по checkworthiness. Каждое ≈ 9 запросов к Tavily + 2 к LLM.
# MAX_CLAIMS_PER_CHUNK=5
# MAX_CLAIMS_PER_JOB=20
# Сколько запросов к поиску одновременно (на весь сервер). Замер: 6 → 40 с, 15 → 25 с, 30 → 16 с на 5 тезисов
# SEARCH_MAX_PARALLEL=30

# ======================= ПРОВАЙДЕРЫ (нужны только этапам в real) =======================
# Распознавание речи — этап 02
ASR_PROVIDER=
ASR_API_KEY=
# LLM — этапы 03, 04 (запросы), 05 (структура копий), 06, 08. Реализовано: openai (например, LLM_MODEL=gpt-6-luna)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# эмбеддинги для дублей текста в дереве (этап 05); по умолчанию text-embedding-3-small
LLM_EMBEDDING_MODEL=
# Поиск — этап 04. Реализовано: tavily
SEARCH_PROVIDER=
SEARCH_API_KEY=
# Google Fact Check Tools — необязательно, этап 04 добавит разборы фактчекеров
GOOGLE_FACTCHECK_API_KEY=

# ======================= РАСШИРЕНИЕ (подставляется при npm run build:ext) =======================
# mock    — события из MOCK_EVENTS прямо в расширении, бэкенд не нужен
# backend — ходить на EXT_BACKEND_URL (а что там — replay или pipeline — решает SERVER_MODE)
EXT_DATA_SOURCE=mock
EXT_BACKEND_URL=http://localhost:8787

# ======================= САЙТ (web/, читается в web/next.config.mjs) =======================
# mock    — отчёты из MOCK_VIDEO_REPORT, проверки хранятся в браузере (localStorage)
# backend — создавать и загружать проверки через POST/GET /api/jobs на WEB_BACKEND_URL
WEB_DATA_SOURCE=mock
WEB_BACKEND_URL=http://localhost:8787
