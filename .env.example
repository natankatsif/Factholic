# Единая конфигурация проекта. Скопируй: cp .env.example .env  (.env в git не попадает)
# Читается в одном месте: backend/src/config.ts (бэкенд) и extension/build.mjs (расширение, при сборке).
# Переменные из командной строки имеют приоритет над .env.

# ======================= БЭКЕНД: сервер =======================
PORT=8787
# pipeline — гонять этапы 01→06 (каждый в mock или real, см. ниже)
# replay   — не запускать пайплайн, проигрывать MOCK_EVENTS из @news/contracts (фронту для разработки UI)
SERVER_MODE=pipeline

# ======================= БЭКЕНД: mock / real по этапам =======================
# mock — этап возвращает данные из своего mock.ts, внешние API не вызываются, ключи не нужны
# real — этап вызывает настоящие API (real.ts), нужны ключи провайдеров ниже
STAGES_DEFAULT=mock
# Переопредели свой этап, не трогая чужие:
# STAGE_INGEST=real
# STAGE_TRANSCRIPTION=real
# STAGE_CLAIM_EXTRACTION=real
# STAGE_SOURCE_SEARCH=real
# STAGE_VERIFICATION=real
# (06-delivery — чистая функция без внешних API, не переключается)

# ======================= ПРОВАЙДЕРЫ (нужны только этапам в real) =======================
# Распознавание речи — этап 02
ASR_PROVIDER=
ASR_API_KEY=
# LLM — этапы 03, 04 (генерация запросов), 05
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Поиск — этап 04
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ======================= РАСШИРЕНИЕ (подставляется при npm run build:ext) =======================
# mock    — события из MOCK_EVENTS прямо в расширении, бэкенд не нужен
# backend — ходить на EXT_BACKEND_URL (а что там — replay или pipeline — решает SERVER_MODE)
EXT_DATA_SOURCE=mock
EXT_BACKEND_URL=http://localhost:8787
